# Settings of the Helmshell systemd service.
# Copy this file to ~/.config/helmshell/helmshell.env (chmod 600), then:
#   systemctl --user restart helmshell
# (install.sh writes it for you)

# Listening address. 0.0.0.0 = all interfaces (mind the firewall).
# To listen on your VPN only, put its IP (e.g. 100.x.y.z).
HELMSHELL_HOST=0.0.0.0
HELMSHELL_PORT=8787

# Initial interface language: en or fr (can be changed later in Settings › Appearance).
HELMSHELL_LANGUAGE=en

# Networks allowed until network access is configured in Settings › Security.
HELMSHELL_ALLOWED_NETWORKS=192.168.0.0/16,100.64.0.0/10

# Projects root folder (also editable in Settings).
#PROJECTS_ROOT=/home/alice/projects

# Fixed password (otherwise: generated on first start, editable in Settings).
# When set here, it cannot be changed from the interface.
#HELMSHELL_PASSWORD=

# Check GitHub for new releases once a day (0 = never).
#HELMSHELL_UPDATE_CHECK=1

# Coolify (also editable in Settings).
#COOLIFY_URL=http://localhost:8000
#COOLIFY_TOKEN=
