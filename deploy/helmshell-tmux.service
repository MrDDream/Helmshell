[Unit]
Description=Serveur tmux de l'hôte pour Helmshell (sessions Claude et terminaux)

[Service]
Type=forking
# Socket dans le dossier personnel (monté dans le conteneur Coolify), pas dans /tmp.
ExecStartPre=/usr/bin/mkdir -p %h/.config/helmshell
ExecStart=/usr/bin/tmux -S %h/.config/helmshell/tmux.sock new-session -d -s _helmshell
ExecStartPost=/usr/bin/tmux -S %h/.config/helmshell/tmux.sock set-option -g exit-empty off
ExecStop=/usr/bin/tmux -S %h/.config/helmshell/tmux.sock kill-server
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
