# Settings of the Helmshell container (deploy/docker-compose.yml).
# Copy this file to deploy/.env and adapt it. In Coolify or Dokploy, set the same variables in the
# environment variables tab of the resource.

# Your home directory on the host (required). It is mounted at the same path in the container.
HELMSHELL_HOME=/home/alice

# Your user on the host: name, UID and GID (run "id" on the server).
HOST_USER=alice
HOST_UID=1000
HOST_GID=1000

# Image version (ghcr.io/mrddream/helmshell): "latest" or a release such as 0.2.0.
#HELMSHELL_VERSION=latest

# Initial interface language: en or fr (can be changed later in Settings › Appearance).
#HELMSHELL_LANG=en

# Port published on the host (IPv4 only).
#HELMSHELL_PORT=8787

# Networks allowed until network access is configured in Settings › Security.
#HELMSHELL_ALLOWED_NETWORKS=192.168.0.0/16,100.64.0.0/10

# Projects folder (inside your home directory; Helmshell's default otherwise).
#HELMSHELL_PROJECTS_ROOT=/home/alice/projects

# Server name shown in the top bar (otherwise the container's).
#HELMSHELL_HOSTNAME=my-server

# Check GitHub for new releases once a day (0 = never).
#HELMSHELL_UPDATE_CHECK=1

# Coolify API as seen from the container (also editable in Settings › Deployment).
#COOLIFY_URL=http://host.docker.internal:8000

# Development variant only (code mounted from the host, see docker-compose.yml):
# folder where you cloned Helmshell (default: $HELMSHELL_HOME/helmshell).
#HELMSHELL_DIR=/home/alice/helmshell
